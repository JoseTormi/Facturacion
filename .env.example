# Rutas
DOWNLOAD_DIR=data/downloads
OUTPUT_DIR=data/output

# Ejemplo de credenciales para un portal.
# Para produccion, usa variables por plataforma y evita subir este archivo con datos reales.
EXAMPLE_PORTAL_USER=usuario@empresa.com
EXAMPLE_PORTAL_PASSWORD=tu-clave

# SAEF
SAEF_STORAGE_DIR=storage
SAEF_DATABASE_PATH=storage/saef.sqlite3

# Gmail OAuth: guarda el JSON descargado de Google Cloud en esta ruta.
SAEF_GMAIL_CREDENTIALS_PATH=credentials/gmail_oauth_client.json
SAEF_GMAIL_TOKEN_PATH=credentials/gmail_token.json

# Activa este proveedor solo cuando ya tengas OAuth configurado.
SAEF_GMAIL_ACTIVE=false
SAEF_GMAIL_PROVIDER_NAME=Gmail
SAEF_GMAIL_SENDER=
SAEF_GMAIL_SUBJECT=

# Acceso web SAEF. Cambia estos valores antes de usarlo.
SAEF_ADMIN_USERNAME=admin
SAEF_ADMIN_PASSWORD=cambia-esta-clave
SAEF_AUTH_SECRET_KEY=cambia-esta-clave-secreta-larga
SAEF_AUTH_SESSION_MINUTES=480
SAEF_AUTH_COOKIE_SECURE=false
